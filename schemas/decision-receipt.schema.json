{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionReceipt",
  "type": "object",
  "required": [
    "version",
    "decisionId",
    "inputs",
    "candidates",
    "result",
    "evidence",
    "integrity"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "decisionId": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "candidates": {
      "type": "array"
    },
    "result": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    },
    "integrity": {
      "type": "object"
    }
  }
}
