# ==============================================================================
# BreakoutGate — Environment Configuration Template (.env.example)
#
# CRITICAL SECURITY INVARIANT (INV-11):
# Never prefix provider API keys with NEXT_PUBLIC_.
# Provider secrets must remain strictly server-side.
# Never commit actual credentials to git.
# ==============================================================================

# Perfect Corp / YouCam API Credentials (Required for Live API Mode)
# Obtain your API key from https://yce.makeupar.com/api-console/
YOUCAM_API_KEY="your_perfect_corp_api_key_here"

# Perfect Corp API Base URL (Optional, defaults to official S2S endpoint)
# Default: https://api.perfectcorp.com
YOUCAM_BASE_URL="https://api.perfectcorp.com"

# Provider Task Polling & Timeout Controls
# Bounded interval and timeout to prevent unbounded polling or runaway API credit usage
YOUCAM_POLL_INTERVAL_MS="1500"
YOUCAM_POLL_TIMEOUT_MS="30000"
YOUCAM_MAX_RETRIES="3"

# Node Environment
NODE_ENV="development"
