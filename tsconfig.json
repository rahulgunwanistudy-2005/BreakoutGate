{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@youcam/*": ["./packages/youcam/*"],
      "@youcam": ["./packages/youcam/index.ts"],
      "@contracts/*": ["./packages/contracts/*"],
      "@contracts": ["./packages/contracts/index.ts"],
      "@evidence/*": ["./packages/evidence/*"],
      "@evidence": ["./packages/evidence/index.ts"],
      "@engine/*": ["./packages/engine/*"],
      "@engine": ["./packages/engine/index.ts"],
      "@receipt/*": ["./packages/receipt/*"],
      "@receipt": ["./packages/receipt/index.ts"],
      "@orchestration/*": ["./packages/orchestration/*"],
      "@orchestration": ["./packages/orchestration/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
